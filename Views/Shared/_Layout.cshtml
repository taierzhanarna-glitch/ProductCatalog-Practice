<!DOCTYPE html>
<html lang="kk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · NORD</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header"><div class="container nav-shell">
        <a class="brand" asp-controller="Products" asp-action="Index"><span class="brand-mark">N</span><span>NORD<small>OBJECTS / 26</small></span></a>
        <nav aria-label="Негізгі навигация"><a asp-controller="Products" asp-action="Index">КАТАЛОГ</a><a href="#about">ЖОБА ТУРАЛЫ</a></nav>
    </div></header>
    <main class="container page-shell">@RenderBody()</main>
    <footer class="site-footer" id="about"><div class="container footer-shell"><span>NORD / OBJECT CATALOG</span><span>RAZOR · MVC · 2026</span></div></footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
